# ============================================================================
# DomHotel Suite — 环境变量样例
# 复制为 .env 或写入容器环境变量。本文件只含键名与说明，不含任何真实凭证。
# 优先级（企业微信相关）：运行时 wecom_runtime_config.json > 环境变量 > 内置默认(空)
# ============================================================================

# ---- 企业微信 自建应用消息 (工单/派单/完成 通知到人) ----
WECOM_CORP_ID=                 # 企业 ID，形如 ww********
WECOM_AGENT_SECRET=            # 自建应用 Secret
WECOM_AGENT_ID=                # 自建应用 AgentId，形如 1000002

# ---- 企业微信 智能表格双向同步 (每张表的 doc_id，接入时填入) ----
WECOM_DOC_STAFF=
WECOM_DOC_DEPARTMENTS=
WECOM_DOC_ROOM_TYPES=
WECOM_DOC_FLOORS=
WECOM_DOC_ROOMS=
WECOM_DOC_WORK_ORDERS=
WECOM_DOC_ROOMS_LOG=
WECOM_DOC_GUESTS_LOG=
WECOM_DOC_SUPPLIES_LOG=
WECOM_DOC_GUESTS=
WECOM_DOC_SUPPLIES=
WECOM_DOC_CUSTOMERS=
WECOM_DOC_PENDING=

# ---- 通讯录同步 (可选, /admin/staff/sync_from_wecom 用) ----
WECOM_CONTACTS_SECRET=         # 通讯录同步独立 Secret（非应用 Secret）
WECOM_TRUSTED_IP=              # 企业可信 IP 白名单中的本机出口 IP

# ---- 微信客服 (KF) ----
WECOM_KF_ID=                   # 客服账号 ID
WECOM_KF_TOKEN=                # 回调校验 Token
WECOM_KF_ENCODING_AES_KEY=     # 回调加解密密钥
KF_CALLBACK_BASE_URL=          # 公网回调基址（拼接回调 URL 用）
KF_AI_AGENT_ID=hotel-ai-guest-service   # 客人非命令文本应答智能体
KF_NOTIFY_USERIDS=             # 内部员工通知 userid，逗号分隔，如 "ZhangSan,LiSi"

# ---- 部门群通知发送方 (工单通知发到哪个 bot) ----
# 留空 = 按 target_dept 自动选 hotel-ai-engineering / hotel-ai-housekeeping /
# hotel-ai-frontdesk（实测各部门 bot 才是群内有效发送方）。
# 若想让所有群统一用某个持长连接的网关 bot，再设此值整体覆盖。
NOTIFY_GROUP_AGENT_ID=

# 运行时配置里可写的 JSON 映射（非 env，走 /wecom/config 或面板）：
#   DEPT_APPCHAT_CHATIDS  = {"engineering":"wr...","housekeeping":"wr...","frontdesk":"wr..."}
#   DEPT_NOTIFY_USERIDS   = {"engineering":["..."],"housekeeping":["..."]}

# ---- 通知重试 / 超时提醒 ----
WO_NOTIFY_RETRY_ATTEMPTS=3
WO_NOTIFY_RETRY_DELAY=2
WO_TIMEOUT_REMINDER_MIN=30
WO_TIMEOUT_REMINDER_INTERVAL=15

# ---- QwenPaw 运行时 (容器内一般已注入, 本地调试才需设) ----
QWENPAW_BASE_URL=http://127.0.0.1:8088
QWENPAW_HOST=0.0.0.0
QWENPAW_PORT=8088
QWENPAW_WORKING_DIR=/app/working
HOTEL_DATA_DIR=/app/working/dompaw-data-backup

# ---- 腾讯云 (语音/其它增值能力, 未用可留空) ----
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ---- 微信公众号 (可选) ----
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
